@page "/"
@using TabletUIAgent.Models

<div class="view-wrapper">
    <nav class="navbar navbar-expand-lg m-3">
        <div class="container-fluid d-flex align-items-center px-3">
            <div class="d-flex">
                <div class="me-2">
                    <h1 class="display-3 my-1 ps-1">rce2</h1>
                </div>
                <div class="alive"></div>
            </div>
            @if (Selected is not null)
            {
                <span class="back-link" role="button" tabindex="0" aria-label="Back"
                      @onclick="OnBack" @onkeydown="OnBackKeyDown">&lt;&lt;&lt;</span>
            }
        </div>
    </nav>

    <div class="m-3 content">
        @if (Selected is null)
        {
            <MainMenu OnClickCard="OnClickCard" />
        }
        else
        {
            <DynamicComponent Type="Selected.Component!" />
        }
    </div>
</div>

@code {
    private MenuItem? Selected;

    private void OnBack()
    {
        Selected = null;
    }

    private void OnBackKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            OnBack();
        }
    }

    private void OnClickCard(string card)
    {
        Selected = MenuCatalog.FindEnabled(card);
    }
}
