@using PubSub
@using Rce2
@implements IDisposable
@inject Rce2Service Rce2Service
@inject IJSRuntime JS

<div class="feature-pane sendit-wrapper">
    <div class="sendit-container">
        <textarea
            class="sendit-input"
            placeholder="Enter message..."
            aria-label="Message"
            @bind="Message">
        </textarea>
        <button class="btn btn-outline-primary touch-btn sendit-btn" @onclick="Send">Send</button>
        <div class="sendit-output">
            @foreach (var line in DebugLines)
            {
                <div class="@(line.Sent ? "sendit-sent" : "sendit-received")">
                    @(line.Sent ? "< " : "> ")@line.Text
                </div>
            }
        </div>
    </div>
</div>

@code {
    private record DebugLine(string Text, bool Sent);

    private string Message = "";
    private List<DebugLine> DebugLines = new();

    public SendIt()
    {
        Hub.Default.Subscribe<Rce2Message>(this, async e =>
        {
            if (e.Contact != "sendit-input")
            {
                return;
            }

            var payload = e.Payload["data"]?.ToObject<string>();
            AddDebugLine(payload ?? "", sent: false);
        });
    }

    public void Dispose()
    {
        Hub.Default.Unsubscribe<Rce2Message>(this);
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(Message) == false)
        {
            try
            {
                await Rce2Service.Send("sendit-output", Message);
                AddDebugLine(Message, sent: true);
                Message = "";
                Toast.Show("Message sent");
            }
            catch (Exception ex)
            {
                Toast.Error($"Send failed: {ex.Message}");
            }
        }
    }

    private void AddDebugLine(string text, bool sent)
    {
        DebugLines.Insert(0, new DebugLine(text, sent));
        StateHasChanged();
    }
}
